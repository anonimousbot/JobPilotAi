{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "JobPilotAi_Backend"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/jobpilotai-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "JobPilotAi",
    "AccessTokenMinutes": 15
  },
  "Ai": {
    "Provider": "Gemini",
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-5.4-mini",
      "TimeoutSeconds": 120,
      "EstimatedInputCostPerMillionTokens": 0.75,
      "EstimatedOutputCostPerMillionTokens": 4.50
    },
    "Gemini": {
      "ApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "Model": "gemma-4-31b-it",
      "FallbackApiKey": "",
      "FallbackBaseUrl": "https://integrate.api.nvidia.com/v1",
      "FallbackModel": "google/gemma-2-27b-it",
      "TimeoutSeconds": 120,
      "EstimatedInputCostPerMillionTokens": 0.075,
      "EstimatedOutputCostPerMillionTokens": 0.30
    },
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com",
      "Model": "claude-sonnet-4-5"
    }
  },
  "FileUploads": {
    "MaxResumeBytes": 10485760,
    "ResumeStoragePath": "storage/resumes"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
