{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System.Net.Http.HttpClient": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=jobpilotai;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "JobPilotAi",
    "AccessTokenMinutes": 15
  },
  "Ai": {
    "Provider": "deterministic",
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "TimeoutSeconds": 120,
      "EstimatedInputCostPerMillionTokens": 0.75,
      "EstimatedOutputCostPerMillionTokens": 4.50
    },
    "Gemini": {
      "ApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "Model": "gemini-2.0-flash",
      "FallbackApiKey": "",
      "FallbackBaseUrl": "https://integrate.api.nvidia.com/v1",
      "FallbackModel": "google/gemma-2-27b-it",
      "TimeoutSeconds": 120,
      "EstimatedInputCostPerMillionTokens": 0.075,
      "EstimatedOutputCostPerMillionTokens": 0.30
    },
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com",
      "Model": "claude-sonnet-4-5"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:51151" ]
  },
  "FileUploads": {
    "MaxResumeBytes": 10485760,
    "ResumeStoragePath": "storage/resumes"
  }
}
